[Unit]
Description=PointVerse API and Web
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
User=alex
Group=alex
WorkingDirectory=/home/alex/pointverse/server
EnvironmentFile=/home/alex/pointverse/server/app.env
ExecStart=/home/alex/pointverse/bin/server
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
