HTTP_ADDR=:8080
DATABASE_URL=postgres://pointverse:pointverse_dev@localhost:5432/pointverse?sslmode=disable

# Comma-separated, exact allowed aud / azp values. Empty means provider disabled.
# Google: configure the server (web) client ID and, if used as azp, the iOS client ID.
GOOGLE_CLIENT_IDS=
# Native Sign in with Apple uses your App ID / Bundle ID (current iOS: org.dianjie.pv).
# Enable Sign in with Apple for the App ID before configuring this.
APPLE_CLIENT_IDS=

# Persistent cloud attachment directory for local Go development. Docker sets /data/cloud.
CLOUD_STORAGE_DIR=data/cloud
